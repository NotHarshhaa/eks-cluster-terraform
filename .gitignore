###### root/.gitignore ######

# Ignore Terraform working directory
.terraform/
**/.terraform/*

# Ignore Terraform state files
*.tfstate
*.tfstate.*

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — dependency lock
# files should be committed so every run uses the same provider versions.
# See: https://developer.hashicorp.com/terraform/cli/commands/init#lock-file-usage

# Ignore Terraform crash logs
crash.log
crash.*.log

# Ignore Terraform variable files (Sensitive Data)
*.tfvars
*.tfvars.json

# Ignore Terraform plan files (Generated during `terraform plan -out=tfplan`)
*.tfplan

# Ignore Terraform override files (Local customization)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Terraform CLI configuration files
.terraformrc
terraform.rc

# Ignore editor and OS-generated files
.vscode/
.idea/
.DS_Store
Thumbs.db
